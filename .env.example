# Copy this file to .env and replace the placeholder values with your local secrets.
DATABASE_URL=postgresql+psycopg2://farmdirect:change-me@localhost:5432/farmdirect_ai
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-long-random-refresh-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAPS_API_KEY=
PAYMENT_PROVIDER=development
ALLOW_DEVELOPMENT_PAYMENTS=false
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
APP_ENV=development
DEMO_MODE=false

# Optional development fallback
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://farmdirect:change-me@localhost:5432/farmdirect_ai
